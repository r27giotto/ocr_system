# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/

# ---------- uv 缓存 ----------
# 沙箱环境下 UV_CACHE_DIR 必须落在工作区内（默认的用户目录缓存会被拒），
# 所以本目录是构建产物，不入库。
.uv-cache/
uv-cache/

# ---------- IDE ----------
.idea/
.vscode/

# ---------- 运行产物 ----------
# 每次启动都会重写，不入库（目录本身由 logs/.gitkeep 保留）
logs/*.log
logs/*.csv
# CSV 迁移时留的备份：results.bak-20261102-101010.csv。上面那条 logs/*.csv
# 匹配不到它（文件名中间多了 .bak-时间戳），不补这行备份文件会被提交进去。
logs/*.bak-*.csv
# 相机模式的落盘目录（config.yaml 的 storage.capture_raw_dir / capture_result_dir）。
# 跑一轮就是几十张 PNG，绝不能进仓库。改成别的路径的话记得同步这里。
logs/captures_raw/
logs/captures_result/
# test/test_camera_mode.py 的落盘目录（它把 storage 指到这里，失败时会保留现场）
logs/_camera_test/

# ---------- 模型权重 ----------
# 模型放在项目内的 models/official_models/（由 main.py 里的 PADDLE_PDX_CACHE_HOME 指定），
# 不随仓库分发：整个目录 477 MB，且是可从 PaddleX 官方重新下载的产物。
models/
# 兜底：万一模型文件出现在别处
*.onnx
*.pdmodel
*.pdiparams
*.pdparams
*.nb

# ---------- 系统 ----------
Thumbs.db
Desktop.ini
.DS_Store

# ---------- 本机快捷方式（含绝对路径，换台机器就是错的）----------
# 「OCR系统.lnk」里记录的是 E:\Python Project\ocr_system\... 这样的绝对路径，
# 提交到仓库后到另一台电脑就是坏链接。快捷方式各机器自己建，不入库。
*.lnk

# ---------- 排查用的临时文件（用完即删，别误提交）----------
# 约定：临时探针脚本一律以 _ 开头，产出物也用 _ 开头。
# 注意不要写成 "_*.py" —— 那会把 __init__.py 也忽略掉。
_verify_*.py
_probe_*.py
_*.txt
_*.png
_*.log
logs/_audit_tmp/

# ---------- 审计/临时目录残留 ----------
# `tempfile.mkdtemp(dir=工作区)` 建出来的目录在本机沙箱下会带受限 ACL，
# 事后连删除都会被拒（audit_wcvyf3at 就是这么留下的）。留着不影响运行，挡在门外即可。
audit_*/
