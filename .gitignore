# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/

# ---------- uv 缓存 ----------
# 沙箱环境下 UV_CACHE_DIR 必须落在工作区内（默认的用户目录缓存会被拒），
# 所以本目录是构建产物，不入库。
.uv-cache/
uv-cache/

# ---------- IDE ----------
.idea/
.vscode/

# ---------- 运行产物 ----------
# 每次启动都会重写，不入库（目录本身由 logs/.gitkeep 保留）
logs/*.log
logs/*.csv

# ---------- 模型权重 ----------
# 模型放在项目内的 models/official_models/（由 main.py 里的 PADDLE_PDX_CACHE_HOME 指定），
# 不随仓库分发：整个目录 477 MB，且是可从 PaddleX 官方重新下载的产物。
models/
# 兜底：万一模型文件出现在别处
*.onnx
*.pdmodel
*.pdiparams
*.pdparams
*.nb

# ---------- 系统 ----------
Thumbs.db
Desktop.ini
.DS_Store

# ---------- 本机快捷方式（含绝对路径，换台机器就是错的）----------
# 「OCR系统.lnk」里记录的是 E:\Python Project\ocr_system\... 这样的绝对路径，
# 提交到仓库后到另一台电脑就是坏链接。快捷方式各机器自己建，不入库。
*.lnk

# ---------- 排查用的临时文件（用完即删，别误提交）----------
# 约定：临时探针脚本一律以 _ 开头，产出物也用 _ 开头。
# 注意不要写成 "_*.py" —— 那会把 __init__.py 也忽略掉。
_verify_*.py
_probe_*.py
_*.txt
_*.png
_*.log
