# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/

# ---------- uv 缓存 ----------
# 沙箱环境下 UV_CACHE_DIR 必须落在工作区内（默认的用户目录缓存会被拒），
# 所以本目录是构建产物，不入库。
.uv-cache/
uv-cache/

# ---------- IDE ----------
.idea/
.vscode/

# ---------- 运行产物 ----------
# 每次启动都会重写，不入库（目录本身由 logs/.gitkeep 保留）
logs/*.log
logs/*.csv

# ---------- 模型权重 ----------
# 模型走 PaddleX 官方缓存目录，不随仓库分发
*.onnx
*.pdmodel
*.pdiparams
*.pdparams
*.nb

# ---------- 系统 ----------
Thumbs.db
Desktop.ini
.DS_Store
